# ============================================================================
# G4IMS Server Configuration
# ============================================================================
# Copy this file to .env and update the values for your environment.
# Run: java -jar inventory-server-1.0.0.jar setup
# The setup command will create and populate this file interactively.
# ============================================================================

# ─── Application / Runtime ──────────────────────────────────────────────────
G4IMS_SERVER_APP_NAME=Inventory Management System - Group 4 API
G4IMS_SERVER_APP_ENV=development
G4IMS_SERVER_APP_VERSION=1.0.0
G4IMS_SERVER_APP_TIMEZONE=UTC
G4IMS_SERVER_APP_BASE_URL=http://localhost:8080
G4IMS_SERVER_APP_CONTEXT_PATH=/api
G4IMS_SERVER_SERVER_HOST=0.0.0.0
G4IMS_SERVER_SERVER_PORT=8080
G4IMS_SERVER_SERVER_BACKLOG=100
G4IMS_SERVER_SERVER_MAX_REQUEST_BODY_BYTES=10485760
G4IMS_SERVER_SERVER_MAX_UPLOAD_BYTES=5242880
G4IMS_SERVER_SERVER_REQUEST_TIMEOUT_SECONDS=30

# ─── Database ───────────────────────────────────────────────────────────────
G4IMS_SERVER_DB_DRIVER=com.mysql.cj.jdbc.Driver
G4IMS_SERVER_DB_HOST=localhost
G4IMS_SERVER_DB_PORT=3306
G4IMS_SERVER_DB_NAME=g4ims_local
G4IMS_SERVER_DB_USER=inventory_user
G4IMS_SERVER_DB_PASSWORD=change_me_secure_password
# G4IMS_SERVER_DB_URL is auto-constructed if not set
G4IMS_SERVER_DB_POOL_MIN_SIZE=2
G4IMS_SERVER_DB_POOL_MAX_SIZE=10
G4IMS_SERVER_DB_POOL_CONNECTION_TIMEOUT_MS=30000
G4IMS_SERVER_DB_POOL_IDLE_TIMEOUT_MS=600000
G4IMS_SERVER_DB_POOL_MAX_LIFETIME_MS=1800000
G4IMS_SERVER_DB_RUN_MIGRATIONS_ON_STARTUP=false
G4IMS_SERVER_DB_RUN_SEED_ON_STARTUP=false

# ─── Authentication / Security ──────────────────────────────────────────────
G4IMS_SERVER_AUTH_TOKEN_TYPE=Bearer
G4IMS_SERVER_AUTH_TOKEN_SECRET=replace_with_long_random_secret_at_least_32_chars
G4IMS_SERVER_AUTH_TOKEN_EXPIRY_SECONDS=1800
G4IMS_SERVER_AUTH_REFRESH_TOKEN_EXPIRY_SECONDS=86400
G4IMS_SERVER_PASSWORD_HASH_ALGORITHM=BCrypt
G4IMS_SERVER_PASSWORD_BCRYPT_COST=10
G4IMS_SERVER_PASSWORD_MIN_LENGTH=8
G4IMS_SERVER_PASSWORD_REQUIRE_UPPERCASE=true
G4IMS_SERVER_PASSWORD_REQUIRE_LOWERCASE=true
G4IMS_SERVER_PASSWORD_REQUIRE_NUMBER=true
G4IMS_SERVER_PASSWORD_REQUIRE_SYMBOL=true
G4IMS_SERVER_SECURITY_SESSION_TIMEOUT_MINUTES=30
G4IMS_SERVER_SECURITY_ALLOW_MULTIPLE_SESSIONS=false
G4IMS_SERVER_SECURITY_LOCK_AFTER_FAILED_ATTEMPTS=5
G4IMS_SERVER_SECURITY_PASSWORD_EXPIRY_DAYS=90
G4IMS_SERVER_SECURITY_REQUIRE_LOGIN_ON_STARTUP=true

# ─── Default Admin Bootstrap ────────────────────────────────────────────────
G4IMS_SERVER_DEFAULT_ADMIN_USERNAME=admin
G4IMS_SERVER_DEFAULT_ADMIN_PASSWORD=Admin@123
G4IMS_SERVER_DEFAULT_ADMIN_EMAIL=admin@inventory.local
G4IMS_SERVER_DEFAULT_ADMIN_FULL_NAME=System Administrator

# ─── Business Rules ─────────────────────────────────────────────────────────
G4IMS_SERVER_INVENTORY_LOW_STOCK_THRESHOLD=10
G4IMS_SERVER_INVENTORY_REORDER_MULTIPLIER=1.50
G4IMS_SERVER_INVENTORY_DEFAULT_PRODUCT_STATUS=In Stock
G4IMS_SERVER_INVENTORY_COSTING_METHOD=Average Cost
G4IMS_SERVER_INVENTORY_ALLOW_NEGATIVE_STOCK=false
G4IMS_SERVER_INVENTORY_AUTO_UPDATE_TOTAL_VALUES=true
G4IMS_SERVER_INVENTORY_WARN_BELOW_THRESHOLD=true
G4IMS_SERVER_INVENTORY_TRACK_EXPIRATION_DATES=false
G4IMS_SERVER_INVENTORY_DEFAULT_EXPIRY_WARNING_DAYS=30
G4IMS_SERVER_INVENTORY_CLERK_CHANGES_REQUIRE_MANAGER_APPROVAL=true
G4IMS_SERVER_SALES_ALLOW_PENDING_INVOICE=true
G4IMS_SERVER_SALES_ALLOW_CANCEL_PAID_INVOICE=true
G4IMS_SERVER_PURCHASE_ALLOW_RECEIVE_PENDING_ONLY=true
G4IMS_SERVER_PURCHASE_ALLOW_CANCEL_RECEIVED=false
G4IMS_SERVER_CURRENCY_NAME=Philippine Peso
G4IMS_SERVER_CURRENCY_CODE=PHP
G4IMS_SERVER_CURRENCY_SYMBOL=₱
G4IMS_SERVER_DEFAULT_TAX_RATE=12.00
G4IMS_SERVER_TAX_TYPE=Inclusive of Tax
G4IMS_SERVER_PRICE_DECIMAL_PLACES=2

# ─── File Storage ───────────────────────────────────────────────────────────
G4IMS_SERVER_FILE_STORAGE_ROOT=./storage
G4IMS_SERVER_UPLOAD_DIR=./storage/uploads
G4IMS_SERVER_INVENTORY_PROOF_UPLOAD_DIR=./storage/uploads/inventory-change-requests
G4IMS_SERVER_EXPORT_DIR=./storage/exports
G4IMS_SERVER_BACKUP_DIR=./storage/backups
G4IMS_SERVER_TEMP_DIR=./storage/tmp
G4IMS_SERVER_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png
G4IMS_SERVER_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png
G4IMS_SERVER_UPLOAD_MAX_IMAGE_BYTES=5242880

# ─── Reports / Export ───────────────────────────────────────────────────────
G4IMS_SERVER_EXPORT_DEFAULT_FORMAT=csv
G4IMS_SERVER_EXPORT_ALLOWED_FORMATS=csv,xlsx,pdf
G4IMS_SERVER_REPORT_DEFAULT_PAGE_SIZE=10
G4IMS_SERVER_REPORT_MAX_PAGE_SIZE=1000
G4IMS_SERVER_PDF_EXPORT_ENABLED=true
G4IMS_SERVER_EXCEL_EXPORT_ENABLED=true
G4IMS_SERVER_CSV_EXPORT_ENABLED=true

# ─── Email / Notifications ──────────────────────────────────────────────────
G4IMS_SERVER_EMAIL_NOTIFICATIONS_ENABLED=false
G4IMS_SERVER_SMTP_HOST=smtp.gmail.com
G4IMS_SERVER_SMTP_PORT=587
G4IMS_SERVER_SMTP_USERNAME=
G4IMS_SERVER_SMTP_PASSWORD=
G4IMS_SERVER_SMTP_USE_SSL=true
G4IMS_SERVER_SMTP_USE_STARTTLS=true
G4IMS_SERVER_EMAIL_FROM=noreply@abctrading.com
G4IMS_SERVER_NOTIFY_LOW_STOCK_ALERTS=true
G4IMS_SERVER_NOTIFY_DAILY_SUMMARY_REPORTS=false
G4IMS_SERVER_NOTIFY_BACKUP_STATUS=true

# ─── Backup / Restore ───────────────────────────────────────────────────────
G4IMS_SERVER_BACKUP_ENABLED=true
G4IMS_SERVER_BACKUP_FREQUENCY=Daily
G4IMS_SERVER_BACKUP_TIME=02:00
G4IMS_SERVER_BACKUP_ON_EXIT=true
G4IMS_SERVER_BACKUP_RETENTION_DAYS=30
G4IMS_SERVER_MYSQLDUMP_BIN=mysqldump
G4IMS_SERVER_MYSQL_BIN=mysql

# ─── CORS / API Access ──────────────────────────────────────────────────────
G4IMS_SERVER_CORS_ENABLED=true
G4IMS_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
G4IMS_SERVER_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
G4IMS_SERVER_CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept

# ─── Logging / Audit ────────────────────────────────────────────────────────
G4IMS_SERVER_LOG_LEVEL=INFO
G4IMS_SERVER_LOG_DIR=./logs
G4IMS_SERVER_LOG_FILE=./logs/inventory-api.log
G4IMS_SERVER_LOG_MAX_FILE_SIZE_MB=10
G4IMS_SERVER_LOG_MAX_HISTORY_DAYS=14
G4IMS_SERVER_AUDIT_LOG_ENABLED=true
G4IMS_SERVER_AUDIT_LOG_REQUEST_BODY=false
G4IMS_SERVER_AUDIT_LOG_RESPONSE_BODY=false

# ─── Swagger / API Docs ─────────────────────────────────────────────────────
G4IMS_SERVER_SWAGGER_ENABLED=true
G4IMS_SERVER_SWAGGER_OPENAPI_FILE=./docs/inventory_system_group4_openapi.yaml

# ─── Development ────────────────────────────────────────────────────────────
G4IMS_SERVER_DEV_SHOW_STACKTRACE=true
G4IMS_SERVER_DEV_ENABLE_DEMO_DATA=false
