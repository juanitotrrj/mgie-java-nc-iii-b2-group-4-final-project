# ============================================================================
# G4IMS Server Environment Variables
# ============================================================================
# Copy to ~/.config/g4ims/g4ims-server.env and source from .bashrc/.zshrc:
#   source ~/.config/g4ims/g4ims-server.env
#
# For Windows, use the register-server-env-windows.ps1 script instead.
# ============================================================================

# ─── Application / Runtime ──────────────────────────────────────────────────
export G4IMS_SERVER_APP_NAME="Inventory Management System - Group 4 API"
export G4IMS_SERVER_APP_ENV=development
export G4IMS_SERVER_APP_VERSION=1.0.0
export G4IMS_SERVER_APP_TIMEZONE=UTC
export G4IMS_SERVER_APP_BASE_URL=http://localhost:8080
export G4IMS_SERVER_APP_CONTEXT_PATH=/api
export G4IMS_SERVER_SERVER_HOST=0.0.0.0
export G4IMS_SERVER_SERVER_PORT=8080
export G4IMS_SERVER_SERVER_BACKLOG=100
export G4IMS_SERVER_SERVER_MAX_REQUEST_BODY_BYTES=10485760
export G4IMS_SERVER_SERVER_MAX_UPLOAD_BYTES=5242880
export G4IMS_SERVER_SERVER_REQUEST_TIMEOUT_SECONDS=30

# ─── Database ───────────────────────────────────────────────────────────────
export G4IMS_SERVER_DB_DRIVER=com.mysql.cj.jdbc.Driver
export G4IMS_SERVER_DB_HOST=localhost
export G4IMS_SERVER_DB_PORT=3306
export G4IMS_SERVER_DB_NAME=inventory_system_group4
export G4IMS_SERVER_DB_USER=inventory_user
export G4IMS_SERVER_DB_PASSWORD=change_me_secure_password
export G4IMS_SERVER_DB_URL="jdbc:mysql://localhost:3306/inventory_system_group4?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&useUnicode=true&characterEncoding=utf8"
export G4IMS_SERVER_DB_POOL_MIN_SIZE=2
export G4IMS_SERVER_DB_POOL_MAX_SIZE=10
export G4IMS_SERVER_DB_POOL_CONNECTION_TIMEOUT_MS=30000
export G4IMS_SERVER_DB_POOL_IDLE_TIMEOUT_MS=600000
export G4IMS_SERVER_DB_POOL_MAX_LIFETIME_MS=1800000
export G4IMS_SERVER_DB_RUN_MIGRATIONS_ON_STARTUP=false
export G4IMS_SERVER_DB_RUN_SEED_ON_STARTUP=false

# ─── Authentication / Security ──────────────────────────────────────────────
export G4IMS_SERVER_AUTH_TOKEN_TYPE=Bearer
export G4IMS_SERVER_AUTH_TOKEN_SECRET=replace_with_long_random_secret_at_least_32_chars
export G4IMS_SERVER_AUTH_TOKEN_EXPIRY_SECONDS=1800
export G4IMS_SERVER_AUTH_REFRESH_TOKEN_EXPIRY_SECONDS=86400
export G4IMS_SERVER_PASSWORD_HASH_ALGORITHM=BCrypt
export G4IMS_SERVER_PASSWORD_BCRYPT_COST=10
export G4IMS_SERVER_PASSWORD_MIN_LENGTH=8
export G4IMS_SERVER_PASSWORD_REQUIRE_UPPERCASE=true
export G4IMS_SERVER_PASSWORD_REQUIRE_LOWERCASE=true
export G4IMS_SERVER_PASSWORD_REQUIRE_NUMBER=true
export G4IMS_SERVER_PASSWORD_REQUIRE_SYMBOL=true
export G4IMS_SERVER_SECURITY_SESSION_TIMEOUT_MINUTES=30
export G4IMS_SERVER_SECURITY_ALLOW_MULTIPLE_SESSIONS=false
export G4IMS_SERVER_SECURITY_LOCK_AFTER_FAILED_ATTEMPTS=5
export G4IMS_SERVER_SECURITY_PASSWORD_EXPIRY_DAYS=90
export G4IMS_SERVER_SECURITY_REQUIRE_LOGIN_ON_STARTUP=true

# ─── Default Admin Bootstrap ────────────────────────────────────────────────
export G4IMS_SERVER_DEFAULT_ADMIN_USERNAME=admin
export G4IMS_SERVER_DEFAULT_ADMIN_PASSWORD=Admin@123
export G4IMS_SERVER_DEFAULT_ADMIN_EMAIL=admin@inventory.local
export G4IMS_SERVER_DEFAULT_ADMIN_FULL_NAME="System Administrator"

# ─── Business Rules ─────────────────────────────────────────────────────────
export G4IMS_SERVER_INVENTORY_LOW_STOCK_THRESHOLD=10
export G4IMS_SERVER_INVENTORY_REORDER_MULTIPLIER=1.50
export G4IMS_SERVER_INVENTORY_DEFAULT_PRODUCT_STATUS="In Stock"
export G4IMS_SERVER_INVENTORY_COSTING_METHOD="Average Cost"
export G4IMS_SERVER_INVENTORY_ALLOW_NEGATIVE_STOCK=false
export G4IMS_SERVER_INVENTORY_AUTO_UPDATE_TOTAL_VALUES=true
export G4IMS_SERVER_INVENTORY_WARN_BELOW_THRESHOLD=true
export G4IMS_SERVER_INVENTORY_TRACK_EXPIRATION_DATES=false
export G4IMS_SERVER_INVENTORY_DEFAULT_EXPIRY_WARNING_DAYS=30
export G4IMS_SERVER_INVENTORY_CLERK_CHANGES_REQUIRE_MANAGER_APPROVAL=true
export G4IMS_SERVER_SALES_ALLOW_PENDING_INVOICE=true
export G4IMS_SERVER_SALES_ALLOW_CANCEL_PAID_INVOICE=true
export G4IMS_SERVER_PURCHASE_ALLOW_RECEIVE_PENDING_ONLY=true
export G4IMS_SERVER_PURCHASE_ALLOW_CANCEL_RECEIVED=false
export G4IMS_SERVER_CURRENCY_NAME="Philippine Peso"
export G4IMS_SERVER_CURRENCY_CODE=PHP
export G4IMS_SERVER_CURRENCY_SYMBOL="₱"
export G4IMS_SERVER_DEFAULT_TAX_RATE=12.00
export G4IMS_SERVER_TAX_TYPE="Inclusive of Tax"
export G4IMS_SERVER_PRICE_DECIMAL_PLACES=2

# ─── File Storage ───────────────────────────────────────────────────────────
export G4IMS_SERVER_FILE_STORAGE_ROOT=./storage
export G4IMS_SERVER_UPLOAD_DIR=./storage/uploads
export G4IMS_SERVER_INVENTORY_PROOF_UPLOAD_DIR=./storage/uploads/inventory-change-requests
export G4IMS_SERVER_EXPORT_DIR=./storage/exports
export G4IMS_SERVER_BACKUP_DIR=./storage/backups
export G4IMS_SERVER_TEMP_DIR=./storage/tmp
export G4IMS_SERVER_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png
export G4IMS_SERVER_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png
export G4IMS_SERVER_UPLOAD_MAX_IMAGE_BYTES=5242880

# ─── Reports / Export ───────────────────────────────────────────────────────
export G4IMS_SERVER_EXPORT_DEFAULT_FORMAT=csv
export G4IMS_SERVER_EXPORT_ALLOWED_FORMATS=csv,xlsx,pdf
export G4IMS_SERVER_REPORT_DEFAULT_PAGE_SIZE=10
export G4IMS_SERVER_REPORT_MAX_PAGE_SIZE=1000
export G4IMS_SERVER_PDF_EXPORT_ENABLED=true
export G4IMS_SERVER_EXCEL_EXPORT_ENABLED=true
export G4IMS_SERVER_CSV_EXPORT_ENABLED=true

# ─── Email / Notifications ──────────────────────────────────────────────────
export G4IMS_SERVER_EMAIL_NOTIFICATIONS_ENABLED=false
export G4IMS_SERVER_SMTP_HOST=smtp.gmail.com
export G4IMS_SERVER_SMTP_PORT=587
export G4IMS_SERVER_SMTP_USERNAME=
export G4IMS_SERVER_SMTP_PASSWORD=
export G4IMS_SERVER_SMTP_USE_SSL=true
export G4IMS_SERVER_SMTP_USE_STARTTLS=true
export G4IMS_SERVER_EMAIL_FROM=noreply@abctrading.com
export G4IMS_SERVER_NOTIFY_LOW_STOCK_ALERTS=true
export G4IMS_SERVER_NOTIFY_DAILY_SUMMARY_REPORTS=false
export G4IMS_SERVER_NOTIFY_BACKUP_STATUS=true

# ─── Backup / Restore ───────────────────────────────────────────────────────
export G4IMS_SERVER_BACKUP_ENABLED=true
export G4IMS_SERVER_BACKUP_FREQUENCY=Daily
export G4IMS_SERVER_BACKUP_TIME=02:00
export G4IMS_SERVER_BACKUP_ON_EXIT=true
export G4IMS_SERVER_BACKUP_RETENTION_DAYS=30
export G4IMS_SERVER_MYSQLDUMP_BIN=mysqldump
export G4IMS_SERVER_MYSQL_BIN=mysql

# ─── CORS / API Access ──────────────────────────────────────────────────────
export G4IMS_SERVER_CORS_ENABLED=true
export G4IMS_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
export G4IMS_SERVER_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
export G4IMS_SERVER_CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept

# ─── Logging / Audit ────────────────────────────────────────────────────────
export G4IMS_SERVER_LOG_LEVEL=INFO
export G4IMS_SERVER_LOG_DIR=./logs
export G4IMS_SERVER_LOG_FILE=./logs/inventory-api.log
export G4IMS_SERVER_LOG_MAX_FILE_SIZE_MB=10
export G4IMS_SERVER_LOG_MAX_HISTORY_DAYS=14
export G4IMS_SERVER_AUDIT_LOG_ENABLED=true
export G4IMS_SERVER_AUDIT_LOG_REQUEST_BODY=false
export G4IMS_SERVER_AUDIT_LOG_RESPONSE_BODY=false

# ─── Swagger / API Docs ─────────────────────────────────────────────────────
export G4IMS_SERVER_SWAGGER_ENABLED=true
export G4IMS_SERVER_SWAGGER_OPENAPI_FILE=./docs/inventory_system_group4_openapi.yaml

# ─── Development ────────────────────────────────────────────────────────────
export G4IMS_SERVER_DEV_SHOW_STACKTRACE=true
export G4IMS_SERVER_DEV_ENABLE_DEMO_DATA=false
